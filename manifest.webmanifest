{
  "id": "./",
  "name": "Accesos iCloud",
  "short_name": "iCloud",
  "description": "Lanzador de los servicios web de iCloud: Correo, Fotos, Drive, Notas, Recordatorios, Calendario, Contactos y Buscar.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f5f7",
  "theme_color": "#0a6cf0",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Correo", "url": "./?abrir=correo", "icons": [{ "src": "icons/atajo-correo.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Fotos", "url": "./?abrir=fotos", "icons": [{ "src": "icons/atajo-fotos.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Drive", "url": "./?abrir=drive", "icons": [{ "src": "icons/atajo-drive.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Calendario", "url": "./?abrir=calendario", "icons": [{ "src": "icons/atajo-calendario.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "capturas/inicio.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Todos los servicios de iCloud en una pantalla" },
    { "src": "capturas/inicio-oscuro.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Modo oscuro automático" }
  ]
}
